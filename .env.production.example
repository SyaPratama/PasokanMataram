# ==============================================================================
# PasokMataram Production Environment Template
# Digunakan untuk GitHub Secrets ENV_PRODUCTION dan cPanel Mode Production.
# ==============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Application Mode untuk Shared Hosting & Next.js
APPLICATION_MODE=production
NEXT_PUBLIC_APP_MODE=production

# Basis Data (MySQL 8.0 Production - cPanel)
DATABASE_URL=mysql://pasokmataram_user:your_secure_production_password_here@localhost:3306/pasokmataram_prod
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pasokmataram_prod
DB_USER=pasokmataram_user
DB_PASSWORD=your_secure_production_password_here
DB_SSL=false

# Redis (Production - cPanel Redis / Memcached)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_cpanel_redis_password_here
REDIS_DB=0
REDIS_URL=redis://:your_cpanel_redis_password_here@localhost:6379/0

# JWT Auth (Minimal 32 Karakter Rahasia)
JWT_SECRET=your_production_jwt_secret_minimum_32_characters_very_secure_here
JWT_EXPIRES_IN=24h
SESSION_EXPIRY_DAYS=7
COOKIE_DOMAIN=.syapratama.tech
COOKIE_SECURE=true

# MinIO / S3 / Cloudinary (Production)
MINIO_ENDPOINT=https://minio.syapratama.tech
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=your_production_minio_access_key
MINIO_SECRET_KEY=your_production_minio_secret_key
MINIO_BUCKET_PRIVATE=kyb-documents-private
CLOUDINARY_CLOUD_NAME=your_production_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_production_cloudinary_api_key
CLOUDINARY_API_SECRET=your_production_cloudinary_api_secret

# Next.js Public URLs (Monorepo - Production)
NEXT_PUBLIC_APP_URL=https://pasok.syapratama.tech
NEXT_PUBLIC_WEB_URL=https://pasok.syapratama.tech
NEXT_PUBLIC_API_URL=https://api.syapratama.tech
WEB_BASE_URL=https://pasok.syapratama.tech
API_BASE_URL=https://api.syapratama.tech

# Mode Pemeliharaan (Maintenance Mode Production)
# Ubah ke true untuk mengalihkan seluruh akses publik ke halaman /maintenance
MAINTENANCE_MODE=false
MAINTENANCE_TITLE="Pemeliharaan Infrastruktur Sistem"
MAINTENANCE_MESSAGE="Sistem pengadaan bahan baku pangan PasokMataram sedang dalam proses peningkatan infrastruktur berkala guna memastikan keandalan transaksi."
MAINTENANCE_ESTIMATED_END="Pukul 12:00 WIB"
MAINTENANCE_BYPASS_TOKEN=your_secret_maintenance_bypass_token_here

# Gateway Pembayaran Solosmartpay (Production)
SOLOSMARTPAY_BASE_URL=https://api.solosmartpay.com
SOLOSMARTPAY_MERCHANT_ID=your_merchant_id_here
SOLOSMARTPAY_API_KEY=your_solosmartpay_api_key_here
SOLOSMARTPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Rekening Escrow Bank BPD DIY (Production)
BPD_DIY_ESCROW_ACCOUNT=your_escrow_account_number
BPD_DIY_VA_PREFIX=988810

# ML Forecasting Service URL (Production)
ML_SERVICE_URL=http://localhost:8000

# Fitur Flag
ENABLE_SANDBOX_MODE=false
ENABLE_DEBUG_LOGGING=false

# Port SSH Shared Hosting (Ubah jika hosting menggunakan custom port, misal: 65002 atau 2222)
SSH_PORT=22
