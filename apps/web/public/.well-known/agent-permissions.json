{
  "version": "1.0",
  "description": "Agent and LLM search crawler permissions for PasokMataram platform",
  "userAgents": {
    "allowed": [
      "GPTBot",
      "ChatGPT-User",
      "ClaudeBot",
      "Claude-Web",
      "PerplexityBot",
      "Google-Extended",
      "Bingbot"
    ]
  },
  "interactions": {
    "read": {
      "allowed": true,
      "paths": [
        "/llms.txt",
        "/llms-full.txt",
        "/komoditas",
        "/alur-pengadaan",
        "/kalkulator",
        "/faq",
        "/tentang",
        "/prediksi-harga",
        "/api/v1/health",
        "/api/v1/pooling/campaigns",
        "/api/v1/logistics/routing",
        "/api/v1/buyer/catalog"
      ]
    },
    "api": {
      "allowed": true,
      "endpoints": [
        "/api/v1/pooling/campaigns",
        "/api/v1/logistics/routing",
        "/api/v1/buyer/catalog",
        "/api/v1/forecast/commodity/*"
      ],
      "rateLimit": "120/minute"
    }
  },
  "rateLimits": {
    "default": "120/minute",
    "authenticated": "1000/minute"
  },
  "contact": "devrel@pasokmataram.com"
}
