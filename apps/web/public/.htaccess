# ==============================================================================
# PasokMataram - LiteSpeed Web Server & cPanel Apache Configuration
# ==============================================================================

# 1. Matikan Directory Browsing (Mencegah tampilan "Index of /")
Options -Indexes
DirectoryIndex disabled

# 2. Redirect Galat Server LiteSpeed ke Router Next.js
ErrorDocument 400 /
ErrorDocument 401 /
ErrorDocument 403 /403
ErrorDocument 404 /404
ErrorDocument 500 /
ErrorDocument 502 /
ErrorDocument 503 /

# 3. Phusion Passenger / LiteSpeed Node.js Application Directives
PassengerEnabled On
PassengerAppEnv production
PassengerFriendlyErrorPages off


# 5. Header Keamanan Baku
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. Proteksi Berkas Sensitif & Lingkungan (.env, .git, dan rahasia kredensial)
<FilesMatch "^\.env|^\.git|^(server|app)\.js$|^stderr\.log$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteRule ^\.env.*$ - [F,L,NC]
    RewriteRule ^\.git.*$ - [F,L,NC]
    RewriteRule ^credentials\.json$ - [F,L,NC]
    RewriteRule ^(server|app)\.js$ - [F,L,NC]
    RewriteRule ^stderr\.log$ - [F,L,NC]
</IfModule>
