# ==============================================================================
# PasokMataram Environment Template (.env.example)
# Replace every placeholder before running outside an isolated local environment.
# Never commit generated credentials.

# Database Configuration (MySQL 8.0)
DB_HOST=localhost
DB_PORT=3307
DB_USER=pasok_user
DB_PASSWORD=replace-with-local-db-password
DB_NAME=pasokmataram_db
DB_SSL=false
# Set DB_FORCE_RESET=true only when forcing full re-seeding on fresh empty staging databases
DB_FORCE_RESET=false
# Redis 7 Distributed Cache & Rate Limiting
REDIS_URL=redis://localhost:6379

# Machine Learning Service (FastAPI / LightGBM)
ML_SERVICE_URL=http://localhost:8000
ML_ALLOWED_HOSTS=localhost,127.0.0.1

# API Gateway & Backend Service
PORT=3001
API_URL=http://localhost:3001

# Web Application & Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_TOKEN=replace-with-random-bypass-token

# Cryptographic & Session Secrets (Min 256-bit entropy)
JWT_SECRET=replace-with-at-least-32-random-characters

# Web Push VAPID Cryptographic Keys (RFC 8292)
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:admin@pasokmataram.com

# Payment Gateway (Solosmartpay - HMAC-SHA256 signature verification)
SOLOSMARTPAY_TOKEN=replace-with-provider-token
SOLOSMARTPAY_WEBHOOK_SECRET=replace-with-provider-webhook-secret

# Object Storage (MinIO / S3 Encrypted Bucket)
MINIO_ACCESS_KEY=replace-with-object-storage-access-key
MINIO_SECRET_KEY=replace-with-object-storage-secret-key
MINIO_ENDPOINT=http://localhost:9000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://pasokmataram.id
