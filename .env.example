# PasokMataram environment variables template
# Salin file ini ke .env.local untuk pengembangan lokal mandiri.

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Aplikasi Frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Basis Data PostgreSQL 16 (Normalisasi 3NF & RLS Multi-Tenant)
DATABASE_URL=postgresql://pasokmataram_user:pasokmataram_password@localhost:5432/pasokmataram_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=pasokmataram_user
DB_PASSWORD=pasokmataram_password
DB_NAME=pasokmataram_db
DB_SSL=false

# Cache & Distributed Mutex Lock (Redis 7)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO Object Storage (Self-Hosted S3 API untuk Dokumen KYB WebP/PDF)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PRIVATE=kyb-documents-private

# Keamanan Sesi & JWT Auth (Minimal 32 karakter rahasia)
JWT_SECRET=rahasia-kunci-otentikasi-jwt-pasokmataram-minimal-32-karakter
SESSION_EXPIRY_DAYS=7
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
