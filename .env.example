# ==============================================================================
# PasokMataram Environment Variables Template
# ==============================================================================
#
# ENVIRONMENT FILE HIERARCHY:
# ---------------------------
# 1. LOCAL DEVELOPMENT:
#    - apps/web/.env.local   → Web frontend (localhost URLs)
#    - apps/api/.env.local   → API backend (localhost URLs)
#    - Use these for local testing with real database
#
# 2. DEVELOPMENT SERVER:
#    - .env.development      → Staging/development server deployment
#
# 3. PRODUCTION SERVER:
#    - .env.production       → Production deployment (cPanel/shared hosting)
#
# This file (.env.example) is a TEMPLATE ONLY.
# Copy values to appropriate environment file based on your use case.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Application Mode (Shared Hosting / LiteSpeed Passenger selector)
# Nilai: 'development' | 'production'
APPLICATION_MODE=development
NEXT_PUBLIC_APP_MODE=development

# Aplikasi Frontend & Backend URLs (Monorepo)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001

# Basis Data MySQL 8.0 (Local Development)
# For local: DB_HOST=localhost, DB_PORT=3306
# For Docker: DB_HOST=mysql (container name)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Rast16808312#
DB_NAME=pasokmataram_local
DB_SSL=false

# Cache & Distributed Mutex Lock (Redis 7 / Shared Hosting Redis Manager)
# Opsi 1: Koneksi TCP Standar (Docker / VPS lokal)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Opsi 2: Koneksi Unix Domain Socket cPanel Shared Hosting (tanpa password)
# Jika menggunakan cPanel Redis Manager, uncomment baris di bawah:
# REDIS_SOCKET=/home/syaprata/redis/redis.sock
# REDIS_URL=unix:///home/syaprata/redis/redis.sock

# Appwrite Storage (Document Storage untuk Dokumen KYB WebP/PDF)
# Endpoint: https://cloud.appwrite.io/v1 (Cloud) atau self-hosted URL
# Setup: Buat project di https://appwrite.io, buat bucket 'kyb-documents', set permissions
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id_here
APPWRITE_API_KEY=your_api_key_here
APPWRITE_BUCKET_ID=kyb-documents

# Keamanan Sesi & JWT Auth (Minimal 32 karakter rahasia)
JWT_SECRET=rahasia-kunci-otentikasi-jwt-pasokmataram-minimal-32-karakter
JWT_EXPIRES_IN=7d
SESSION_EXPIRY_DAYS=7
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Mode Pemeliharaan (Maintenance Mode)
MAINTENANCE_MODE=false
MAINTENANCE_TITLE="Pemeliharaan Sistem Terpadu"
MAINTENANCE_MESSAGE="Sistem pengadaan bahan baku pangan PasokMataram sedang dalam proses peningkatan infrastruktur berkala guna memastikan keandalan transaksi."
MAINTENANCE_ESTIMATED_END="Dalam Waktu Dekat"
MAINTENANCE_BYPASS_TOKEN=pasok_dev_preview

# Gateway Pembayaran Solosmartpay (Multi-Channel: QRIS, VA, e-Wallet)
# Sandbox: https://sandbox.solosmartpay.com | Production: https://api.solosmartpay.com
# Webhook URL: https://pasok.syapratama.tech/api/v1/webhooks/solosmartpay
SOLOSMARTPAY_API_TOKEN=ssp_test_sandbox_token_here
SOLOSMARTPAY_WEBHOOK_SECRET=whsec_sandbox_secret_key_here
SOLOSMARTPAY_SANDBOX=true
# ML Forecasting Service URL
ML_SERVICE_URL=http://localhost:8000

# Fitur Flag
ENABLE_SANDBOX_MODE=true
ENABLE_DEBUG_LOGGING=true

# Konfigurasi Shared Hosting Deployment (GitHub Secrets)
# SSH_HOST=pasok.syapratama.tech
# SSH_PORT=22
# SSH_USER=cpanel_user
# SSH_PASSWORD=cpanel_password
# WEB_DEPLOY_PATH=/home/username/public_html
# API_DEPLOY_PATH=/home/username/api
# WEB_URL=https://pasok.syapratama.tech
# API_URL=https://api.syapratama.tech
