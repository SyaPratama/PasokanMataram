# PasokMataram Development Environment Template
# Copy this file to .env.development and fill in actual values

NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pasokmataram_dev
DB_USER=postgres
DB_PASSWORD=your_dev_password_here

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_dev_jwt_secret_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# MinIO S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Next.js Public URLs (Monorepo)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# Feature Flags
ENABLE_SANDBOX_MODE=true
ENABLE_DEBUG_LOGGING=true
