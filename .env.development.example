# ==============================================================================
# PasokMataram Development Environment Template
# Digunakan untuk GitHub Secrets ENV_DEVELOPMENT dan cPanel Mode Development.
# ==============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Application Mode untuk Shared Hosting & Next.js
APPLICATION_MODE=development
NEXT_PUBLIC_APP_MODE=development

# Basis Data (MySQL 8.0 Development - Kredensial Terpisah)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pasokmataram_dev
DB_USER=root
DB_PASSWORD=your_dev_password_here
DB_SSL=false

# Redis (Development)
# Opsi 1: Koneksi TCP Standar
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Opsi 2: Unix Domain Socket (cPanel Redis Manager lokal)
# REDIS_SOCKET=/home/syaprata/redis/redis.sock
# REDIS_URL=unix:///home/syaprata/redis/redis.sock

# Keamanan Sesi & JWT Auth (Minimal 32 Karakter Rahasia)
JWT_SECRET=your_dev_jwt_secret_minimum_32_characters_here
JWT_EXPIRES_IN=7d
SESSION_EXPIRY_DAYS=7
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Appwrite Storage (Development)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_dev_project_id
APPWRITE_API_KEY=your_dev_api_key
APPWRITE_BUCKET_ID=kyb-documents-dev

# Next.js Public URLs (Monorepo Development)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001

# Mode Pemeliharaan (Maintenance Mode Development)
MAINTENANCE_MODE=false
MAINTENANCE_TITLE="Pemeliharaan Lingkungan Pengembangan"
MAINTENANCE_MESSAGE="Lingkungan pengembangan PasokMataram sedang dalam proses pembaharuan modul."
MAINTENANCE_ESTIMATED_END="Segera Selesai"
MAINTENANCE_BYPASS_TOKEN=pasok_dev_preview

# Payment Gateway (solosmartpay | xendit | duitku | midtrans)
PAYMENT_PROVIDER=solosmartpay

# SoloSmartPay
SOLOSMARTPAY_TOKEN=ssp_test_sandbox_token_here
SOLOSMARTPAY_WEBHOOK_SECRET=whsec_sandbox_secret_key_here
SOLOSMARTPAY_BASE_URL=https://api.solosmartpay.com/v1
SOLOSMARTPAY_SANDBOX=true
SOLOSMARTPAY_CALLBACK_URL=http://localhost:3000/api/v1/webhooks/solosmartpay

# Xendit
XENDIT_SECRET_KEY=xnd_development_demo
XENDIT_WEBHOOK_TOKEN=demo_xendit_token
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_SANDBOX=true
XENDIT_CALLBACK_URL=http://localhost:3000/api/v1/webhooks/xendit

# Duitku
DUITKU_MERCHANT_CODE=D0001
DUITKU_API_KEY=demo_api_key
DUITKU_WEBHOOK_SECRET=demo_webhook_secret
DUITKU_BASE_URL=https://sandbox.duitku.com/webapi
DUITKU_SANDBOX=true
DUITKU_CALLBACK_URL=http://localhost:3000/api/v1/webhooks/duitku

# Midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-demo
MIDTRANS_CLIENT_KEY=SB-Mid-client-demo
MIDTRANS_WEBHOOK_SECRET=demo_webhook_secret
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com/v2
MIDTRANS_SANDBOX=true
MIDTRANS_CALLBACK_URL=http://localhost:3000/api/v1/webhooks/midtrans

# ML Forecasting Service URL
ML_SERVICE_URL=http://localhost:8000

# Fitur Flag
ENABLE_SANDBOX_MODE=true
ENABLE_DEBUG_LOGGING=true

# Port SSH Shared Hosting (Ubah jika hosting menggunakan custom port, misal: 65002 atau 2222)
SSH_PORT=22
