name: CI

on:
  push:
    branches:
      - main
      - master
  pull_request:
    branches:
      - main
      - master

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  NODE_ENV: test
  CI: "true"

jobs:
  code-cleanliness:
    name: Code Cleanliness Audit
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install Dependencies
        run: npm ci

      - name: Run Cleanliness Static Audit
        run: node scripts/audit-cleanliness.mjs

  lint-and-typecheck:
    name: Lint & Typecheck
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install Dependencies
        run: npm ci

      - name: Verify Types Across Monorepo
        run: npx tsc --noEmit

      - name: Run ESLint
        run: npx turbo run lint

  test:
    name: Vitest Test Suite
    runs-on: ubuntu-latest
    env:
      DATABASE_URL: postgresql://root:Tama123@localhost:5432/pasokmataram_db
      REDIS_URL: redis://localhost:6379
      MINIO_ENDPOINT: http://localhost:9000
      JWT_SECRET: ci-vitest-test-jwt-secret-token-key-at-least-32-chars
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install Dependencies
        run: npm ci

      - name: Run Vitest Suites with Coverage
        run: npx vitest run --coverage

  build:
    name: Turborepo Production Compile
    needs: [code-cleanliness, lint-and-typecheck, test]
    runs-on: ubuntu-latest
    env:
      NEXT_PUBLIC_APP_URL: https://pasokmataram.com
      DATABASE_URL: postgresql://root:Tama123@localhost:5432/pasokmataram_db
      JWT_SECRET: ci-build-jwt-secret-dummy-token-verification-32chars
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install Dependencies
        run: npm ci

      - name: Monorepo Production Build
        run: npm run build
