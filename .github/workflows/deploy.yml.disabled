name: Deploy to Production (Shared Hosting)

on:
  push:
    branches: [main]
  workflow_dispatch:

env:
  NODE_VERSION: '20.x'

jobs:
  security-audit:
    name: Security Audit
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'
      
      - name: Install dependencies
        run: npm ci
      
      - name: ESLint security rules
        run: npx eslint . --ext .ts,.tsx --max-warnings 0
        continue-on-error: true
      
      - name: TypeScript strict check
        run: npx tsc --noEmit
      
      - name: ESLint security rules
        run: npx eslint . --ext .ts,.tsx --max-warnings 0
        continue-on-error: true
      
      - name: Check for exposed secrets
        run: |
          echo "Checking for exposed secrets..."
          if grep -r "sk_live\|pk_live\|AWS_SECRET\|API_KEY" --include="*.ts" --include="*.tsx" --include="*.js" apps/ packages/ services/; then
            echo "ERROR: Potential exposed secrets found"
            exit 1
          fi

  ponytail-audit:
    name: Ponytail Code Quality Audit
      - name: Check for overengineering patterns
        run: |
          echo "=== Ponytail Audit: Checking for unnecessary abstraction ==="
          
          # Check for unused dependencies
          echo "Checking for unused dependencies..."
          npx depcheck --ignores="@types/*,eslint-*,prettier,typescript" || true
          
          # Check for TODO/FIXME debt
          echo "Checking for technical debt markers..."
          grep -r "TODO\|FIXME\|XXX\|HACK\|shortcut:" --include="*.ts" --include="*.tsx" apps/ packages/ services/ || echo "No debt markers found"
        continue-on-error: true
          echo "Checking for interfaces with only one implementation..."
          find . -name "*.ts" -type f | while read file; do
            interface_count=$(grep -c "^export interface" "$file" 2>/dev/null || echo 0)
            if [ "$interface_count" -gt 5 ]; then
              echo "WARNING: $file has $interface_count interfaces (possible over-abstraction)"
            fi
          done
          
          # Check for unused dependencies
          echo "Checking for unused dependencies..."
          npx depcheck --ignores="@types/*,eslint-*,prettier,typescript" || true
          
          # Check for TODO/FIXME debt
          echo "Checking for technical debt markers..."
          grep -r "TODO\|FIXME\|XXX\|HACK\|shortcut:" --include="*.ts" --include="*.tsx" apps/ packages/ services/ || echo "No debt markers found"
      
      - name: Check bundle size
        run: |
          echo "Analyzing bundle size..."
          npm run build || echo "Build failed, skipping bundle analysis"
          if [ -d "apps/web/.next" ]; then
            echo "Next.js build size:"
            du -sh apps/web/.next
          fi

  test:
    name: Run Tests
    runs-on: ubuntu-latest
    needs: [security-audit, ponytail-audit]
    
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_PASSWORD: testpass
          POSTGRES_DB: test_db
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432
      
      redis:
        image: redis:7-alpine
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 6379:6379
    
    steps:
      - uses: actions/checkout@v4
      
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'
      
      - name: Install dependencies
        run: npm ci
      
      - name: Run tests
        run: npm test
        env:
          DB_HOST: localhost
          DB_PORT: 5432
          DB_NAME: test_db
          DB_USER: postgres
          DB_PASSWORD: testpass
          REDIS_URL: redis://localhost:6379
          JWT_SECRET: test-secret-key-32-chars-minimum

  build:
    name: Build Production
    runs-on: ubuntu-latest
    needs: test
    steps:
      - uses: actions/checkout@v4
      
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'
      
      - name: Install dependencies
        run: npm ci
      
      - name: Build all packages
        run: npm run build
      
      - name: Create deployment artifact
        run: |
          mkdir -p deploy
          cp -r apps/web/.next deploy/
          cp -r apps/api/dist deploy/api
          cp -r services/*/dist deploy/services/ 2>/dev/null || true
          cp package*.json deploy/
          cp -r node_modules deploy/
      
      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: production-build
          path: deploy/
          retention-days: 1

  deploy:
    name: Deploy to Shared Hosting
    runs-on: ubuntu-latest
    needs: build
    if: github.ref == 'refs/heads/main'
    environment:
      name: production
      url: https://pasokmataram.com
    
    steps:
      - uses: actions/checkout@v4
      
      - name: Download artifact
        uses: actions/download-artifact@v4
        with:
          name: production-build
          path: deploy/
      
      - name: Setup SSH
        run: |
          mkdir -p ~/.ssh
          echo "${{ secrets.SSH_PRIVATE_KEY }}" > ~/.ssh/id_rsa
          chmod 600 ~/.ssh/id_rsa
          ssh-keyscan -H ${{ secrets.SSH_HOST }} >> ~/.ssh/known_hosts
      
      - name: Deploy via rsync
        run: |
          rsync -avz --delete \
            --exclude 'node_modules' \
            --exclude '.git' \
            --exclude '.env.local' \
            deploy/ ${{ secrets.SSH_USER }}@${{ secrets.SSH_HOST }}:${{ secrets.DEPLOY_PATH }}/
      
      - name: Install production dependencies
        run: |
          ssh ${{ secrets.SSH_USER }}@${{ secrets.SSH_HOST }} << 'EOF'
            cd ${{ secrets.DEPLOY_PATH }}
            npm ci --production
          EOF
      
      - name: Restart services (PM2)
        run: |
          ssh ${{ secrets.SSH_USER }}@${{ secrets.SSH_HOST }} << 'EOF'
            cd ${{ secrets.DEPLOY_PATH }}
            pm2 restart pasokmataram-web || pm2 start npm --name "pasokmataram-web" -- start
            pm2 restart pasokmataram-api || pm2 start npm --name "pasokmataram-api" -- run start:api
            pm2 save
          EOF
      
      - name: Health check
        run: |
          sleep 10
          curl --fail ${{ secrets.APP_URL }}/health || exit 1
      
      - name: Cleanup old artifacts
        run: |
          ssh ${{ secrets.SSH_USER }}@${{ secrets.SSH_HOST }} << 'EOF'
            cd ${{ secrets.DEPLOY_PATH }}
            find . -name "*.log" -mtime +7 -delete
            pm2 flush
          EOF
      
      - name: Deployment notification
        if: always()
        run: |
          STATUS="${{ job.status }}"
          if [ "$STATUS" == "success" ]; then
            echo "✅ Deployment successful"
          else
            echo "❌ Deployment failed"
            exit 1
          fi

  post-deploy-validation:
    name: Post-Deploy Validation
    runs-on: ubuntu-latest
    needs: deploy
    steps:
      - name: Wait for service stabilization
        run: sleep 30
      
      - name: Smoke test critical endpoints
        run: |
          echo "Testing critical endpoints..."
          
          # Homepage
          curl --fail --silent --show-error ${{ secrets.APP_URL }} > /dev/null
          echo "✅ Homepage accessible"
          
          # API health
          curl --fail --silent --show-error ${{ secrets.APP_URL }}/api/health > /dev/null
          echo "✅ API health check passed"
          
          # Login page
          curl --fail --silent --show-error ${{ secrets.APP_URL }}/login > /dev/null
          echo "✅ Login page accessible"
      
      - name: Performance check (Lighthouse)
        uses: treosh/lighthouse-ci-action@v10
        with:
          urls: ${{ secrets.APP_URL }}
          uploadArtifacts: true
          temporaryPublicStorage: true
          runs: 1
